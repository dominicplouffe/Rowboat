  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
