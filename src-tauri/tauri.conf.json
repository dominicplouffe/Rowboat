{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rowboat",
  "mainBinaryName": "rowboat",
  "version": "0.1.0",
  "identifier": "com.dominicplouffe.rowboat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowboat",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast SQL client with an AI copilot",
    "longDescription": "Rowboat is a fast, lightweight SQL client for PostgreSQL, ClickHouse and SQLite with an AI copilot that knows your schema.",
    "copyright": "Copyright (c) 2026 Dominic Plouffe",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/dominicplouffe/Rowboat",
    "publisher": "Dominic Plouffe",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/rowboat.svg": "../assets/brand/icon.svg"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/rowboat.svg": "../assets/brand/icon.svg"
        }
      }
    }
  }
}
